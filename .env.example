# Required for the default Anthropic provider
ANTHROPIC_API_KEY=sk-ant-...

# Optional: switch to OpenAI Responses API function calling
# OPENAI_API_KEY=sk-...
# AIWEBTEST_AGENT_PROVIDER=openai
# AIWEBTEST_MODEL=<openai-model>

# Optional: switch to OpenRouter Chat Completions
# OPENROUTER_API_KEY=sk-or-...
# AIWEBTEST_AGENT_PROVIDER=openrouter
# AIWEBTEST_MODEL=~anthropic/claude-sonnet-latest
# AIWEBTEST_OPENROUTER_HTTP_REFERER=http://localhost:8000
# AIWEBTEST_OPENROUTER_APP_TITLE=aiwebtest

# Instruction normalizer (pre-pass that rewrites the test into a canonical, deterministic
# spec before driving the browser). On by default; disable with the toggle below.
# AIWEBTEST_AGENT__NORMALIZE_INSTRUCTION=false
# By default it reuses the run's provider/model and API keys. Override to run it on a
# cheaper/faster model — or a different provider — without touching the main run:
# AIWEBTEST_NORMALIZER_PROVIDER=anthropic     # empty = reuse AIWEBTEST_AGENT_PROVIDER
# AIWEBTEST_NORMALIZER_MODEL=claude-haiku-4-5 # empty = reuse AIWEBTEST_MODEL
# Token optimization: keep the canonical spec compact (fewer input tokens downstream) and
# the pass cheap. Tight output cap + low effort by default.
# AIWEBTEST_NORMALIZER_MAX_TOKENS=1024
# AIWEBTEST_NORMALIZER_EFFORT=low             # empty = reuse AIWEBTEST_EFFORT
# Optional dedicated keys for the normalizer (each falls back to the matching provider
# key above when empty):
# NORMALIZER_ANTHROPIC_API_KEY=sk-ant-...
# NORMALIZER_OPENAI_API_KEY=sk-...
# NORMALIZER_OPENROUTER_API_KEY=sk-or-...

# Self-healing suite replays: when an `auto` replay ERRORS (a broken/renamed locator,
# not a failed assertion) the agent first re-points only the failing step against the
# live page in-process, keeping the rest of the deterministic replay, before falling back
# to a full agent re-run. On by default; disable to always go straight to the full re-run:
# AIWEBTEST_AGENT__LOCALIZED_REPAIR=false

# Optional overrides (env beats config/default.yaml)
# AIWEBTEST_MODEL=claude-opus-4-8
# AIWEBTEST_EFFORT=high
# AIWEBTEST_BROWSER__HEADLESS=true      # set true in CI / headless containers
# AIWEBTEST_LOG_LEVEL=DEBUG             # trace normalization and every agent (LLM) call
