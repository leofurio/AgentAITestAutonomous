# Required for the default Anthropic provider
ANTHROPIC_API_KEY=sk-ant-...

# Optional: switch to OpenAI Responses API function calling
# OPENAI_API_KEY=sk-...
# AIWEBTEST_AGENT_PROVIDER=openai
# AIWEBTEST_MODEL=<openai-model>

# Optional: switch to OpenRouter Chat Completions
# OPENROUTER_API_KEY=sk-or-...
# AIWEBTEST_AGENT_PROVIDER=openrouter
# AIWEBTEST_MODEL=~anthropic/claude-sonnet-latest
# AIWEBTEST_OPENROUTER_HTTP_REFERER=http://localhost:8000
# AIWEBTEST_OPENROUTER_APP_TITLE=aiwebtest

# Optional overrides (env beats config/default.yaml)
# AIWEBTEST_MODEL=claude-opus-4-8
# AIWEBTEST_EFFORT=high
# AIWEBTEST_BROWSER__HEADLESS=true      # set true in CI / headless containers
